# The active-experiment write-up and its figures ship with the repo; the rule
# above this block was scoped to the parent paper's scratch notes.
!/RESULTS.md
figures/*
!figures/*.png
!figures/*.pdf

# === GitHub release scope (NeurIPS submission code source) ===
# The published repo carries only what the appendix references: runnable
# code, the five canonical panel trace folders, and the cited aggregated
# CSVs. Everything below is kept locally but excluded from the push.

# Top-level folders not part of the code release.
docs/*
notebooks/
reports/
research/
tests/*

# V1 change log is internal; not referenced by the paper.
/V1_CHANGE_LOG.md

# Runner scripts not cited in the appendix.
/run_corr_obs_probe.py
/run_pc_only_ladder.py

# scripts/ — keep only the two utilities cited by the appendix
# (extract_trace_rows.py: F.131-136; ladder_random_floor_sanity.py: C.36).
scripts/*
!scripts/extract_trace_rows.py
!scripts/ladder_random_floor_sanity.py

# === Active-experiment studies (docs/IDEAS.md) ===
# These ARE part of the release: re-include them past the parent-paper exclusions above.
!docs/REPO_OVERVIEW.md
!docs/IDEAS.md
!docs/RUNNING_ON_SERVER.md
!tests/test_active.py
!scripts/setup_env.sh
!scripts/study1.sh
!scripts/study2.sh
!scripts/analyze.py
!scripts/make_figures.py

# Keep episode/step CSVs, manifests and the analysis outputs; drop the bulky raw call log.
traces/study1/**/events.jsonl
traces/study2/**/events.jsonl
traces/study1/smoke/
traces/study2/smoke/
logs/

# === RauMa revision: verifier-calibration + local-readout additions ===
# Figure/audit scripts the paper's appendix now cites.
!scripts/make_rauma_figures.py
!scripts/make_rauma_figures_v2.py
!scripts/make_rauma_figure_verifier.py
!scripts/rauma_edge_audit.py
!figures/edge_audit.json

# Rendered PNGs duplicate the PDFs the TeX uses and are not referenced by the
# README, so only the vector versions ship.
figures/rauma_*.png

# study1/ results: same policy as traces/ — keep episode/step/decision CSVs,
# manifests and summaries (the paper's numbers recompute from these); drop the
# bulky raw call log, the resume checkpoints and the smoke run.
study1/**/events.jsonl
study1/**/checkpoint.json
study1/smoke/

# paper/: ship the source that compiles, not the build artifacts or drafts.
paper/*.aux
paper/*.log
paper/*.out
paper/*.xdv
paper/*.fls
paper/*.fdb_latexmk
paper/*_backup.tex
paper/rauma_revised.tex
paper/rauma_neurips2026.pdf

# Local editor / review scratch.
*.code-workspace
/reviews.md
/paper/REVIEW_VI.md

# result/: same policy as study1/ — keep the CSV/manifest logs the paper recomputes
# from, drop the raw call traces and resume checkpoints.
result/**/events.jsonl
result/**/checkpoint.json

# === NemChua (study 2): proposal-content controls + semantic study ===
!scripts/check_models.py
!scripts/make_nemchua_figures.py
!scripts/nemchua_edit_audit.py
!run_study2_semantic.py

# study2/ results: same policy as study1/ — keep episode/step CSVs, manifests and
# summaries, drop the resume checkpoints and the smoke runs. The raw call log stays:
# the paper's edit-precision audit reads the proposals back out of it.
study2/**/checkpoint.json
study2/smoke/
study2/semantic_smoke/
paper/nemchua_neurips2026.pdf
!paper/nemchua_numbers.py
